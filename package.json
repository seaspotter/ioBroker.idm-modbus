{
  "name": "iobroker.idm-modbus",
  "version": "0.1.8",
  "description": "Connects IDM heat pumps with Navigator control to ioBroker locally via Modbus TCP: read, control and feed room, PV and building-automation values",
  "author": {
    "name": "SeaSpotter",
    "email": "seatowage@gmail.com"
  },
  "contributors": [],
  "homepage": "https://github.com/seaspotter/ioBroker.idm-modbus",
  "license": "MIT",
  "keywords": [
    "ioBroker",
    "idm",
    "heatpump",
    "modbus",
    "navigator",
    "pv"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/seaspotter/ioBroker.idm-modbus.git"
  },
  "engines": {
    "node": ">= 24"
  },
  "dependencies": {
    "@iobroker/adapter-core": "^3.4.3",
    "modbus-connect": "^5.0.5"
  },
  "devDependencies": {
    "@alcalzone/release-script": "^5.2.1",
    "@alcalzone/release-script-plugin-iobroker": "^5.2.0",
    "@alcalzone/release-script-plugin-license": "^5.2.2",
    "@alcalzone/release-script-plugin-manual-review": "^5.2.0",
    "@iobroker/adapter-dev": "^1.5.0",
    "@iobroker/dev-server": "^0.8.0",
    "@iobroker/eslint-config": "^2.3.4",
    "@iobroker/testing": "^6.3.0",
    "@tsconfig/node24": "^24.0.5",
    "@types/iobroker": "npm:@iobroker/types@^7.2.5",
    "@types/node": "^24.19.2",
    "@typescript/native": "npm:typescript@^7.0.2",
    "rimraf": "^6.1.3",
    "source-map-support": "^0.5.21",
    "ts-node": "^10.9.2",
    "typescript": "npm:@typescript/typescript6@^6.0.2"
  },
  "main": "build/main.js",
  "files": [
    "admin{,/!(src)/**}/!(tsconfig|tsconfig.*|.eslintrc).{json,json5}",
    "admin{,/!(src)/**}/*.{html,css,png,svg,jpg,js}",
    "build/",
    "www/",
    "io-package.json",
    "LICENSE"
  ],
  "scripts": {
    "prebuild": "rimraf build",
    "build": "tsc -p tsconfig.build.json",
    "watch": "tsc -p tsconfig.build.json --watch",
    "prebuild:ts": "rimraf build",
    "build:ts": "tsc -p tsconfig.build.json",
    "watch:ts": "tsc -p tsconfig.build.json --watch",
    "test:ts": "mocha --config test/mocharc.custom.json \"src/**/*.test.ts\"",
    "test:package": "mocha test/package --exit",
    "test:integration": "mocha test/integration --exit",
    "test": "npm run test:ts && npm run test:package",
    "check": "tsc --noEmit",
    "build:registers": "ts-node tools/build-registers.ts",
    "build:faults": "ts-node tools/build-faults.ts",
    "translate:strings": "ts-node tools/translate-strings.ts",
    "build:diagram": "ts-node tools/build-diagram-labels.ts",
    "scan:device": "ts-node tools/scan-device.ts",
    "scan:reclassify": "ts-node tools/reclassify-scan.ts",
    "lint": "eslint -c eslint.config.mjs .",
    "translate": "translate-adapter",
    "release": "release-script",
    "dev-server": "dev-server"
  },
  "bugs": {
    "url": "https://github.com/seaspotter/ioBroker.idm-modbus/issues"
  },
  "readmeFilename": "README.md"
}
